# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bank_db?schema=public"

# JWT Secret for signing auth tokens (Replace with a random 32+ character string in production)
JWT_SECRET=super_secret_banking_jwt_key_12345
JWT_EXPIRES_IN=7d

